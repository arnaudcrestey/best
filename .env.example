# Valeurs serveur uniquement. Ne jamais mettre ces secrets dans NEXT_PUBLIC_*.
# Arrêt par défaut : aucun appel payant ni email sans configuration et validation.
BEST_AUTOMATION_MODE=off
BEST_AI_ENABLED=false
BEST_EMAIL_ENABLED=false
BEST_SITE_ORIGIN=https://best.systia.fr

# Modèle et budget à valider avant activation ; aucune clé existante recopiée.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VECTOR_STORE_ID=vs_67ffb68804148191b6fc88a1b167d784
# Facultatif, 20 par défaut. Limite par instance, PAS un plafond global de coût.
# Cache volatile : pas d'anti-doublon garanti après redémarrage ou entre instances.
BEST_DEMO_INSTANCE_DAILY_LIMIT=20
# Formulaire ouvert : ni code d'accès ni liste de destinataires autorisés.
# Aucun stockage externe ni abonnement supplémentaire nécessaire.

# Messagerie déjà utilisée par le site ; vérifier les valeurs sur l'hébergement.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=contact@systia.fr
BEST_REPLY_TO=demande@arnaudcrestey.com
